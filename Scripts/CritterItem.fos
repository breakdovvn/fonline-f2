// CritterItem — общий доступ к активным предметам криттера по слоту.
// Обязанности: ActiveSlot (активная рабочая рука), GetActive/GetSlotItemProto (предмет или рукопашный прото слота).
// Сторона: COMMON (без #if). Связи: Game.GetProtoItem, Parameters.BestUnarmedProto, ItemProps (CritterSlot), Content.
namespace CritterItem
{

// Активная рабочая рука: Main или Secondary. Значение 0 (старые записи без ActiveItemSlot) трактуем как Main.
int ActiveSlot(Critter cr)
{
    return cr.ActiveItemSlot == CritterItemSlot::Secondary ? CritterItemSlot::Secondary : CritterItemSlot::Main;
}

// Задаёт активную руку; допустимы только Main и Secondary.
void SetActiveSlot(Critter cr, int slot)
{
    cr.ActiveItemSlot = uint8(slot == int(CritterItemSlot::Secondary) ? int(CritterItemSlot::Secondary) : int(CritterItemSlot::Main));
}

// Переключает активную руку Main <-> Secondary, не трогая предметы в слотах.
void ToggleActiveSlot(Critter cr)
{
    SetActiveSlot(cr, int(cr.ActiveItemSlot) == int(CritterItemSlot::Secondary) ? int(CritterItemSlot::Main) : int(CritterItemSlot::Secondary));
}

// Возвращает активный предмет в слоте; при пустом слоте руки — лучший рукопашный прото этого слота
// (Main — удар рукой, Secondary — удар ногой), для брони — дефолтный прото брони.
AbstractItem GetActive(Critter cr, int slot = -1)
{
    if (slot < 0) {
        slot = ActiveSlot(cr);
    }

    Item? item = cr.GetItem(ItemProperty::CritterSlot, slot);
    if (item == null) {
        if (slot == CritterItemSlot::Armor) {
            ProtoItem proto = Game.GetProtoItem("default_armor".hstr());
            return proto;
        }

        if (slot == CritterItemSlot::Main || slot == CritterItemSlot::Secondary) {
#if !MAPPER
            return Parameters::BestUnarmedProto(cr, slot == CritterItemSlot::Secondary);
#endif
#if MAPPER
            ProtoItem proto = Game.GetProtoItem(Content::Item::default_weapon);
            return proto;
#endif
        }
    }

    verify(item != null, "Active item not found");
    return item;
}

// Возвращает прото предмета в слоте; при пустом слоте руки — лучший рукопашный прото этого слота,
// для брони — дефолтный прото брони, для прочих слотов — null.
ProtoItem ? GetSlotItemProto(Critter cr, int slot = -1)
{
    if (slot < 0) {
        slot = ActiveSlot(cr);
    }

    Item? item = cr.GetItem(ItemProperty::CritterSlot, slot);
    if (item == null) {
        if (slot == CritterItemSlot::Armor) {
            return Game.GetProtoItem("default_armor".hstr());
        }

        if (slot == CritterItemSlot::Main || slot == CritterItemSlot::Secondary) {
#if !MAPPER
            return Parameters::BestUnarmedProto(cr, slot == CritterItemSlot::Secondary);
#endif
#if MAPPER
            return Game.GetProtoItem(Content::Item::default_weapon);
#endif
        }

        return null;
    }

    hstring weapPid = item.ProtoId;
    return Game.GetProtoItem(weapPid);
}

}
