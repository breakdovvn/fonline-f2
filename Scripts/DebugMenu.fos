// DebugMenu — внутриигровое модальное дебаг-меню клиента (выдача предметов, правка SPECIAL/навыков,
// перков/трейтов, телепорт). Строит экран GuiScreen::DebugMenu программно (не через .fogui), чтобы
// вся логика жила в одном скрипте и не требовала правок генерируемого GuiScreens.fos.
// CLIENT: открывается по F7 (InputHandler) или командой "~menu" (Messaging). Действия уходят на сервер
// единым путём CurPlayer.ServerCall.DebugRunCommand(...) — та же логика, что и у консольных ~команд.
// Гейт Debug.AllowConsoleCommands проверяется сервером (Scripts/DebugCommands.fos); меню — только UI.
namespace DebugMenu
{

///@ Enum GuiScreen DebugMenu

#if CLIENT

// Палитра. Панели/кнопки тонируются цветом поверх white_pixel (чёрный пиксель при умножении на цвет
// остаётся чёрным, поэтому подложка обязана быть белой).
const ucolor ColBg = ucolor(7, 9, 14, 255);
const ucolor ColPanel = ucolor(26, 33, 46, 255);
const ucolor ColPanelAlt = ucolor(17, 22, 33, 255);
const ucolor ColBorder = ucolor(72, 96, 128, 255);
const ucolor ColAccent = ucolor(52, 88, 134, 255);
const ucolor ColButton = ucolor(42, 54, 72, 255);
const ucolor ColButtonHot = ucolor(86, 122, 168, 255);
const ucolor ColText = ucolor(224, 231, 242, 255);
const ucolor ColDim = ucolor(150, 164, 184, 255);
const ucolor ColRed = ucolor(176, 62, 62, 255);
const ucolor ColBlue = ucolor(58, 104, 168, 255);
const ucolor ColYellow = ucolor(172, 140, 56, 255);
const ucolor ColGreen = ucolor(38, 92, 56, 255);
const ucolor ColWhite = ucolor(255, 255, 255, 255);

const FontType FontBody = FontType::Default;
const FontType FontHead = FontType::Fat;

// Идентификаторы действий кнопок (передаются в DebugButton.ActionId -> DebugMenu::OnButton).
const int ActTabItems = 1000;
const int ActTabStats = 1001;
const int ActTabPerks = 1002;
const int ActTabTeleport = 1003;
const int ActClose = 1010;
const int ActHeal = 1020;
const int ActCaps = 1021;
const int ActGod = 1022;
const int ActCatBase = 1100; // + индекс категории предметов
const int ActGiveX1 = 1200;
const int ActGiveX10 = 1201;
const int ActGiveX100 = 1202;
const int ActGiveX1000 = 1203;
const int ActItemUp = 1210;
const int ActItemDown = 1211;
const int ActClearSearch = 1212;
const int ActApplySearch = 1213;
const int ActSpecialDec10 = 1300;
const int ActSpecialDec1 = 1301;
const int ActSpecialInc1 = 1302;
const int ActSpecialInc10 = 1303;
const int ActSpecialMax = 1304;
const int ActSkillDec10 = 1310;
const int ActSkillDec1 = 1311;
const int ActSkillInc1 = 1312;
const int ActSkillInc10 = 1313;
const int ActSkillMax = 1314;
const int ActSkillAll = 1315;
const int ActSkillUp = 1316;
const int ActSkillDown = 1317;
const int ActTraitToggle = 1320;
const int ActTraitClear = 1321;
const int ActTraitUp = 1322;
const int ActTraitDown = 1323;
const int ActPerkDec1 = 1330;
const int ActPerkInc1 = 1331;
const int ActPerkClear = 1332;
const int ActPerkUp = 1333;
const int ActPerkDown = 1334;
const int ActLocUp = 1340;
const int ActLocDown = 1341;
const int ActMapUp = 1342;
const int ActMapDown = 1343;
const int ActLocApplySearch = 1344;
const int ActLocClearSearch = 1345;
const int ActTpEntry = 1350;
const int ActTpCoords = 1351;
const int ActTpGlobal = 1352;
const int ActExecCmd = 1360;

// Высоты строк подобраны под LineHeight встроенного шрифта, чтобы тексты списков не слипались.
const int ItemRows = 12;
const int SkillRows = 12;
const int TraitRows = 12;
const int PerkRows = 12;
const int LocRows = 13;
const int MapRows = 5;
const int ListRowH = 20;
const int SpecialRowH = 22;
const string WhitePixel = "art/intrface/white_pixel.png";

// Состояние меню (клиентское, живёт между показами экрана).
int CurTab = ActTabItems;
int CurCategory = 0;
int ItemScroll = 0;
int SelectedItem = -1;
int SelectedSpecial = 0;
int SkillScroll = 0;
int TraitScroll = 0;
int PerkScroll = 0;
int SelectedSkill = 0;
int SelectedTrait = -1;
int SelectedPerk = -1;
int LocScroll = 0;
int SelectedLoc = -1;
int MapScroll = 0;
int SelectedMap = -1;
string SearchQuery = "";
hstring[] FilteredItems = {};
string LocSearchQuery = "";
hstring[] FilteredLocations = {};

// Регистрация ленивая: экран создаётся при первом открытии, когда ресурсы и спрайты уже готовы
// (штатные экраны регистрируются в Gui::EngineCallback_Start через GuiScreens::InitializeScreens).
bool DebugScreenRegistered = false;

void EnsureDebugScreenRegistered()
{
    if (DebugScreenRegistered) {
        return;
    }

    Gui::RegisterScreen(GuiScreen::DebugMenu, CreateDebugMenuScreen);
    DebugScreenRegistered = true;
}

// Кнопка с числовым идентификатором действия: позволяет создавать однотипные кнопки без класса на каждую.
class DebugButton : Gui::Button
{
    int ActionId = 0;

    void OnLMouseClick() override
    {
        DebugMenu::OnButton(ActionId);
    }
}

// Базовая ячейка-строка списка: текст берётся из виртуальных RowText/RowSelected, клик — RowClick.
// Ячейки создаются клонированием прототипа (Grid.ResizeGrid), поэтому данных на экземпляр не храним —
// только CellIndex, по которому читаем живое состояние Chosen.
class DebugCell : Gui::Text
{
    int RowW = 100;
    int RowH = 20;

    void OnInit() override
    {
        SetHasOnDraw(true);
        SetTextFont(FontBody);
        SetTextColor(ColText);
        SetTextFlags(FontFlag(int(FontFlag::CenterY)));
        SetSize(RowW, RowH);
    }

    string RowText()
    {
        return "";
    }

    bool RowSelected()
    {
        return false;
    }

    void RowClick()
    {
    }

    string get_Text() override
    {
        return RowText();
    }

    void OnDraw() override
    {
        SetTextColor(RowSelected() ? ColWhite : (IsHovered ? ColButtonHot : ColText));
    }

    // Роль списка для прокрутки колесом: 1 — предметы, 2 — локации, 0 — без прокрутки.
    int WheelRole()
    {
        return 0;
    }

    void OnMouseClick(MouseButton button) override
    {
        if (button == MouseButton::WheelUp) {
            DebugMenu::ScrollList(WheelRole(), -1);
        }
        else if (button == MouseButton::WheelDown) {
            DebugMenu::ScrollList(WheelRole(), 1);
        }
    }

    void OnLMouseClick() override
    {
        RowClick();
    }
}

// Ячейка списка предметов.
class ItemCell : DebugCell
{
    void OnInit() override
    {
        RowW = 326;
        RowH = ListRowH;
        DebugCell::OnInit();
    }

    string RowText() override
    {
        return DebugMenu::ItemRowText(CellIndex);
    }

    bool RowSelected() override
    {
        return DebugMenu::ItemRowSelected(CellIndex);
    }

    void RowClick() override
    {
        DebugMenu::ItemRowClick(CellIndex);
    }

    int WheelRole() override
    {
        return 1;
    }
}

// Ячейка списка SPECIAL.
class SpecialCell : DebugCell
{
    void OnInit() override
    {
        RowW = 292;
        RowH = SpecialRowH;
        DebugCell::OnInit();
    }

    string RowText() override
    {
        return DebugMenu::SpecialRowText(CellIndex);
    }

    bool RowSelected() override
    {
        return CellIndex == SelectedSpecial;
    }

    void RowClick() override
    {
        SelectedSpecial = CellIndex;
    }
}

// Ячейка списка навыков.
class SkillCell : DebugCell
{
    void OnInit() override
    {
        RowW = 332;
        RowH = ListRowH;
        DebugCell::OnInit();
    }

    string RowText() override
    {
        return DebugMenu::SkillRowText(CellIndex);
    }

    bool RowSelected() override
    {
        return SkillScroll + CellIndex == SelectedSkill;
    }

    void RowClick() override
    {
        SelectedSkill = SkillScroll + CellIndex;
    }

    int WheelRole() override
    {
        return 4;
    }
}

